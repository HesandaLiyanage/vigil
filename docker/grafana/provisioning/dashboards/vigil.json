{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Fleet Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "title": "Fleet Up / Down",
      "type": "stat",
      "targets": [
        { "expr": "vigil_db_up", "legendFormat": "{{target}} ({{engine}})", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 43200 },
              { "color": "red", "value": 86400 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Time Since Last Proven Restorable",
      "type": "stat",
      "targets": [
        { "expr": "time() - vigil_restore_last_success_epoch_seconds", "legendFormat": "{{target}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "FAIL" }, "1": { "color": "green", "text": "PASS" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Last Drill Status",
      "type": "stat",
      "targets": [
        { "expr": "vigil_restore_last_status", "legendFormat": "{{target}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Access Drift Findings",
      "type": "stat",
      "targets": [
        { "expr": "sum by (target, severity) (vigil_access_drift_findings)", "legendFormat": "{{target}} [{{severity}}]", "refId": "A" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "Restore Verification & RTO",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "pointSize": 5, "showPoints": "always" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 5,
      "title": "Measured RTO (Recovery Time Objective)",
      "type": "timeseries",
      "targets": [
        { "expr": "vigil_restore_rto_seconds", "legendFormat": "{{target}} RTO", "refId": "A" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "Replication & Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 17 },
      "id": 6,
      "title": "Replication Lag: Heartbeat vs Reported (Seconds_Behind_Source)",
      "type": "timeseries",
      "targets": [
        { "expr": "vigil_db_replication_lag_heartbeat_ms", "legendFormat": "{{target}} Heartbeat Lag (True)", "refId": "A" },
        { "expr": "vigil_db_replication_lag_reported_ms", "legendFormat": "{{target}} Reported Lag (SBS)", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "STOPPED" }, "1": { "color": "green", "text": "RUNNING" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 17 },
      "id": 7,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Replica Threads Running",
      "type": "stat",
      "targets": [
        { "expr": "vigil_db_replication_io_running", "legendFormat": "{{target}} IO Thread", "refId": "A" },
        { "expr": "vigil_db_replication_sql_running", "legendFormat": "{{target}} SQL Thread", "refId": "B" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 103,
      "title": "Database Resources & Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 26 },
      "id": 8,
      "title": "Connections Used %",
      "type": "timeseries",
      "targets": [
        { "expr": "vigil_db_connections_active / vigil_db_connections_max * 100", "legendFormat": "{{target}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 26 },
      "id": 9,
      "title": "Storage by Target",
      "type": "timeseries",
      "targets": [
        { "expr": "vigil_db_storage_bytes", "legendFormat": "{{target}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 26 },
      "id": 10,
      "title": "Oracle Tablespace Max Used %",
      "type": "timeseries",
      "targets": [
        { "expr": "vigil_db_tablespace_used_pct_max", "legendFormat": "{{target}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "id": 11,
      "title": "Collection Failures (rate/5m)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(vigil_collection_failures_total[5m])", "legendFormat": "{{target}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "id": 12,
      "title": "Process CPU Usage",
      "type": "timeseries",
      "targets": [
        { "expr": "process_cpu_usage", "legendFormat": "Vigil CPU", "refId": "A" }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["vigil", "database", "rto"],
  "time": { "from": "now-1h", "to": "now" },
